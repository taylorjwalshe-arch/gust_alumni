generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Person {
  id               String   @id @default(cuid())
  email            String?  @unique
  userId           String?  @unique
  firstName        String
  lastName         String
  role             String
  gradYear         Int?
  industries       Json
  company          String?
  title            String?
  expertise        Json
  teamAffiliation  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  description String?
  createdAt   DateTime @default(now())
}

